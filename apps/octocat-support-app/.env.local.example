# No environment file or credentials are needed for local template previews.
# Preview mode blocks issue creation even if GitHub credentials are present.
SUPPORT_MODE=preview

# Optional live publishing: explicitly change SUPPORT_MODE to live.
# Use a dedicated test repository and a fine-grained PAT restricted to it
# with Issues: read/write. Never put real tokens in this example file.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=

# Optional live AI triage also requires an authenticated Copilot CLI.
# Preview is always template-based. An AI failure never falls back silently.
USE_COPILOT_SDK=false
