{
  "name": "octocat-blog-app",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --port 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test:ci": "jest --config ./config/jest/jest.config.js --setupFiles dotenv/config --maxWorkers=2 --ci",
    "test": "jest --config ./config/jest/jest.config.js --setupFiles dotenv/config",
    "test:watch": "jest --config ./config/jest/jest.config.js --setupFiles dotenv/config --watch",
    "test:coverage": "jest --config ./config/jest/jest.config.js --setupFiles dotenv/config --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "npx tsx src/db/seed.ts",
    "db:drop": "drizzle-kit drop",
    "db:reset": "drizzle-kit push --force && pnpm db:seed"
  },
  "dependencies": {
    "@next/swc-win32-x64-msvc": "^16.2.11",
    "@workspace/ui": "workspace:*",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.475.0",
    "marked": "^18.0.7",
    "next": "15.5.18",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanitize-html": "2.17.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@swc/jest": "^0.2.39",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:*",
    "dotenv": "^16.6.1",
    "drizzle-kit": "^0.30.6",
    "eslint": "^9.39.5",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-canvas-mock": "^2.5.8",
    "jest-environment-jsdom": "^29.7.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
