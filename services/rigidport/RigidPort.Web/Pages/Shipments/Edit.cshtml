@page
@model RigidPort.Web.Pages.Shipments.EditModel
@{
    ViewData["Title"] = $"Edit {Model.Shipment.TrackingNumber}";
}

<div class="mb-4">
    <a asp-page="Details" asp-route-id="@Model.Shipment.Id" class="text-decoration-none text-muted small">
        <i class="bi bi-arrow-left me-1"></i> Back to Details
    </a>
    <h4 class="fw-bold mt-1"><i class="bi bi-pencil me-2"></i>Edit @Model.Shipment.TrackingNumber</h4>
</div>

<div class="content-card p-4" style="max-width: 800px;">
    <form method="post">
        <input type="hidden" asp-for="Shipment.Id" />
        <input type="hidden" asp-for="Shipment.TrackingNumber" />
        <input type="hidden" asp-for="Shipment.CreatedAt" />
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label fw-semibold">Status</label>
                <select asp-for="Shipment.Status" asp-items="Model.Statuses" class="form-select"></select>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-semibold">Container</label>
                <select asp-for="Shipment.ContainerId" asp-items="Model.Containers" class="form-select">
                    <option value="">No container</option>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-semibold">Origin Port</label>
                <select asp-for="Shipment.OriginPortId" asp-items="Model.Ports" class="form-select"></select>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-semibold">Destination Port</label>
                <select asp-for="Shipment.DestinationPortId" asp-items="Model.Ports" class="form-select"></select>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-semibold">Customer</label>
                <select asp-for="Shipment.CustomerId" asp-items="Model.Customers" class="form-select"></select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold">Weight (kg)</label>
                <input asp-for="Shipment.WeightKg" class="form-control" type="number" step="0.1" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold">Value (USD)</label>
                <input asp-for="Shipment.Value" class="form-control" type="number" step="0.01" />
            </div>
            <div class="col-md-6">
                <label class="form-label fw-semibold">Estimated Arrival</label>
                <input asp-for="Shipment.EstimatedArrival" class="form-control" type="date" />
            </div>
            <div class="col-12">
                <label class="form-label fw-semibold">Cargo Description</label>
                <textarea asp-for="Shipment.CargoDescription" class="form-control" rows="3"></textarea>
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-teal me-2"><i class="bi bi-check-lg me-1"></i> Save Changes</button>
                <a asp-page="Details" asp-route-id="@Model.Shipment.Id" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </div>
    </form>
</div>
