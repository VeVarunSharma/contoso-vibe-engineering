@page
@model RigidPort.Web.Pages.Customers.DetailsModel
@{
    ViewData["Title"] = Model.Customer.CompanyName;
    var delivered = Model.Customer.Shipments.Count(s => s.Status == ShipmentStatus.Delivered);
    var active = Model.Customer.Shipments.Count(s => s.Status != ShipmentStatus.Delivered && s.Status != ShipmentStatus.Cancelled);
    var totalValue = Model.Customer.Shipments.Sum(s => s.Value);
}

<div class="mb-4">
    <a asp-page="Index" class="text-decoration-none text-muted small"><i class="bi bi-arrow-left me-1"></i>Back to Customers</a>
    <h4 class="fw-bold mt-1"><i class="bi bi-building me-2"></i>@Model.Customer.CompanyName</h4>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="content-card p-4 mb-3">
            <h6 class="fw-bold mb-3">Contact Information</h6>
            <div class="mb-2"><i class="bi bi-person me-2 text-muted"></i>@Model.Customer.ContactName</div>
            <div class="mb-2"><i class="bi bi-envelope me-2 text-muted"></i>@Model.Customer.Email</div>
            @if (Model.Customer.Phone != null) { <div class="mb-2"><i class="bi bi-phone me-2 text-muted"></i>@Model.Customer.Phone</div> }
            @if (Model.Customer.Address != null) { <div class="mb-2"><i class="bi bi-geo-alt me-2 text-muted"></i>@Model.Customer.Address</div> }
            <div class="small text-muted mt-3">Customer since @Model.Customer.CreatedAt.ToString("MMM yyyy")</div>
        </div>
        <div class="row g-3">
            <div class="col-6"><div class="kpi-card p-3 text-center"><div class="kpi-value text-teal">@Model.Customer.Shipments.Count</div><div class="kpi-label">Total</div></div></div>
            <div class="col-6"><div class="kpi-card p-3 text-center"><div class="kpi-value text-warning">@active</div><div class="kpi-label">Active</div></div></div>
            <div class="col-6"><div class="kpi-card p-3 text-center"><div class="kpi-value text-success">@delivered</div><div class="kpi-label">Delivered</div></div></div>
            <div class="col-6"><div class="kpi-card p-3 text-center"><div class="kpi-value" style="font-size:1.2rem;">@totalValue.ToString("C0")</div><div class="kpi-label">Value</div></div></div>
        </div>
    </div>
    <div class="col-md-8">
        <div class="content-card">
            <div class="card-header">Shipment History</div>
            <div class="table-responsive">
                <table class="table table-rp">
                    <thead><tr><th>Tracking #</th><th>Route</th><th>Status</th><th>Value</th></tr></thead>
                    <tbody>
                        @foreach (var s in Model.Customer.Shipments.OrderByDescending(s => s.CreatedAt))
                        {
                            <tr>
                                <td><a asp-page="/Shipments/Details" asp-route-id="@s.Id" class="text-decoration-none text-teal fw-semibold">@s.TrackingNumber</a></td>
                                <td>@s.OriginPort.Code → @s.DestinationPort.Code</td>
                                <td><span class="status-badge status-@s.Status.ToString().ToLower()">@s.Status</span></td>
                                <td>@s.Value.ToString("C0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
