@page
@model RigidPort.Web.Pages.Customers.IndexModel
@{
    ViewData["Title"] = "Customers";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-people me-2"></i>Customers</h4>
        <p class="text-muted mb-0">@Model.Customers.Count customer(s)</p>
    </div>
    <a asp-page="Create" class="btn btn-teal"><i class="bi bi-plus-lg me-1"></i> New Customer</a>
</div>

<div class="content-card p-3 mb-4">
    <form method="get" class="row g-3 align-items-end">
        <div class="col-md-8">
            <div class="search-box">
                <i class="bi bi-search"></i>
                <input type="text" class="form-control" name="Search" value="@Model.Search" placeholder="Search by company, contact, or email..." />
            </div>
        </div>
        <div class="col-md-4">
            <button type="submit" class="btn btn-teal w-100"><i class="bi bi-search me-1"></i> Search</button>
        </div>
    </form>
</div>

<div class="row g-3">
    @foreach (var c in Model.Customers)
    {
        <div class="col-md-6 col-lg-4">
            <a asp-page="Details" asp-route-id="@c.Id" class="text-decoration-none">
                <div class="content-card p-3 h-100">
                    <div class="d-flex align-items-center mb-2">
                        <div class="rounded-circle bg-teal text-white d-flex align-items-center justify-content-center me-3" style="width:40px;height:40px;min-width:40px;">
                            @c.CompanyName[0]
                        </div>
                        <div>
                            <div class="fw-bold text-dark">@c.CompanyName</div>
                            <div class="small text-muted">@c.ContactName</div>
                        </div>
                    </div>
                    <div class="small text-muted"><i class="bi bi-envelope me-1"></i>@c.Email</div>
                    @if (c.Phone != null) { <div class="small text-muted"><i class="bi bi-phone me-1"></i>@c.Phone</div> }
                    <div class="mt-2">
                        <span class="badge bg-light text-dark">@c.Shipments.Count shipment(s)</span>
                    </div>
                </div>
            </a>
        </div>
    }
</div>
