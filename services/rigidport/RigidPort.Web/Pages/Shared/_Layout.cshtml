<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RigidPort</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-navy sticky-top">
        <div class="container-fluid">
            <a class="navbar-brand d-flex align-items-center" href="/">
                <i class="bi bi-ship me-2 fs-4"></i>
                <span class="fw-bold">RigidPort</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-page="/Index">
                            <i class="bi bi-speedometer2 me-1"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-page="/Shipments/Index">
                            <i class="bi bi-box-seam me-1"></i> Shipments
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-page="/Containers/Index">
                            <i class="bi bi-grid-3x3-gap me-1"></i> Containers
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-page="/Customers/Index">
                            <i class="bi bi-people me-1"></i> Customers
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-page="/Tracking/Index">
                            <i class="bi bi-geo-alt me-1"></i> Track
                        </a>
                    </li>
                </ul>
                <div class="d-flex align-items-center">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="text-light small me-2">@User.Identity.Name</span>
                        <a class="btn btn-outline-light btn-sm me-2" asp-area="" asp-page="/Auth/Logout">Logout</a>
                    }
                    else
                    {
                        <a class="btn btn-outline-light btn-sm me-2" asp-area="" asp-page="/Auth/Login">Login</a>
                    }
                    <button id="themeToggle" class="btn btn-outline-light btn-sm me-2" title="Toggle theme">
                        <i class="bi bi-moon-stars"></i>
                    </button>
                    <span class="badge bg-teal">
                        <i class="bi bi-circle-fill text-success me-1" style="font-size: 0.5rem;"></i> System Online
                    </span>
                </div>
            </div>
        </div>
    </nav>

    <main class="container-fluid py-4">
        @RenderBody()
    </main>

    <footer class="bg-navy text-light py-3 mt-4">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-6">
                    <small>&copy; @DateTime.UtcNow.Year RigidPort Logistics — Where flexibility meets rigidity</small>
                </div>
                <div class="col-md-6 text-md-end">
                    <small class="text-muted">Built with ASP.NET Core 9 &amp; Bootstrap 5</small>
                </div>
            </div>
        </div>
    </footer>

    <div class="toast-container position-fixed bottom-0 end-0 p-3" id="toastContainer"></div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
