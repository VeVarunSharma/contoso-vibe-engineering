{
  "name": "@contoso/medical-api",
  "version": "1.0.0",
  "description": "PIPA BC compliant medical patient API for demo purposes",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.11.0",
    "@hono/zod-validator": "^0.2.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.21",
    "hono-rate-limiter": "^0.5.3",
    "jose": "^6.2.3",
    "pg": "^8.11.0",
    "uuid": "^10.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.9",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^10.0.0",
    "@workspace/eslint-config": "workspace:*",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.32.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.6",
    "tsx": "^4.15.0",
    "typescript": "^5.9.2"
  }
}

