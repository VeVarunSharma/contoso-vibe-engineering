{
  "name": "ai-tool-digest",
  "version": "0.1.0",
  "private": true,
  "description": "Azure Function to gather AI development tool updates and email solution engineer summaries.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && func start",
    "start:watch": "func start",
    "lint": "eslint src --ext .ts",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "dependencies": {
    "@azure/functions": "^4.16.2",
    "applicationinsights": "^2.9.8",
    "cheerio": "^1.2.0",
    "nodemailer": "^9.0.3",
    "rss-parser": "^3.13.0",
    "striptags": "^3.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^6.4.24",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
